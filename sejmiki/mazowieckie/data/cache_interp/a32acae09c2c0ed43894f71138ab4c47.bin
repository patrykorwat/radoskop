    <script>
        var likeUrl = "/admin/counter/count-like";
        var pageId = 80471;

        $(function () {
            $(".fa-thumbs-o-up").click(function () {
                $.ajax({
                    url: likeUrl,
                    method: 'post',
                    dataType: 'json',
                    data: {
                        id: pageId,
                        type: 'up'
                    },
                    error: function (response) {
                        var upCnt;
                        var downCnt;
                        if (response.data.up != undefined && response.data.down != undefined && response.status != undefined && response.status == 2)
                        {
                            upCnt = response.data.up;
                            downCnt = response.data.down;

                            $('#counterUp').text(upCnt);
                            $('#counterDown').text(downCnt);

                            $.flashMessenger(response.message, 'info', true);
                        } else
                        if (response.data.up != undefined && response.data.down != undefined)
                        {
                            upCnt = response.data.up;
                            downCnt = response.data.down;

                            $('#counterUp').text(upCnt);
                            $('#counterDown').text(downCnt);
                        } else
                            $.flashMessenger('Błąd aplikacji, proszę spróbować ponownie lub skontaktować się z administratorem systemu.', 'error', true);
                    },
                    success: function (response) {
                        var upCnt = response.data.up;
                        var downCnt = response.data.down;

                        $('#counterUp').text(upCnt);
                        $('#counterDown').text(downCnt);
                    },
                    complete: function () {
                        $('.fa-thumbs-o-up').off('click');
                        $('.fa-thumbs-o-down').off('click');
                    }
                });

            });

            $(".fa-thumbs-o-down").click(function () {
                $.ajax({
                    url: likeUrl,
                    method: 'post',
                    dataType: 'json',
                    data: {
                        id: pageId,
                        type: 'down'
                    },
                    error: function (response) {
                        $.flashMessenger('Błąd aplikacji, proszę spróbować ponownie lub skontaktować się z administratorem systemu.', 'error', true);
                    },
                    success: function (response) {
                        var upCnt;
                        var downCnt;
                        if (response.data.up != undefined && response.data.down != undefined && response.status != undefined && response.status == 2)
                        {
                            upCnt = response.data.up;
                            downCnt = response.data.down;

                            $('#counterUp').text(upCnt);
                            $('#counterDown').text(downCnt);

                            $.flashMessenger(response.message, 'info', true);
                        } else
                        if (response.data.up != undefined && response.data.down != undefined)
                        {
                            upCnt = response.data.up;
                            downCnt = response.data.down;

                            $('#counterUp').text(upCnt);
                            $('#counterDown').text(downCnt);
                        } else
                            $.flashMessenger('Błąd aplikacji, proszę spróbować ponownie lub skontaktować się z administratorem systemu.', 'error', true);
                    },
                    complete: function () {
                        $('.fa-thumbs-o-up').off('click');
                        $('.fa-thumbs-o-down').off('click');
                    }
                });

            });

        });

    </script>
