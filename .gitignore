.venv
*.pyc
__pycache__/
.DS_Store

# pytest cache. W niektórych środowiskach (NAS/sandbox) gdy domyślny katalog
# cache jest read-only, pytest tworzy zastępcze pytest-cache-files-<losowy>/
# w cwd przy każdym uruchomieniu — ignorujemy oba warianty.
.pytest_cache/
pytest-cache-files-*/

# Per-city scrape outputs and generated assets — large, churn often, durable
# copy lives in s3://radoskop-public/{slug}/. Monorepo keeps only code and
# config; rebuild is a single NAS run.
cities/*/docs/
cities/*/.cache/
cities/*/cache/
cities/*/data/
cities/*/pdfs/

# Sejmiki: jak miasta. docs/ to wygenerowany output scrape'u, trwała kopia
# żyje w s3://radoskop-public/{slug}/ przez deploy_all_s3.py. Repo trzyma tylko
# kod i config; cache lokalne (PDFy, HTML, snapshoty BIP) zostają na NAS.
assemblies/*/docs/
assemblies/*/.cache/
assemblies/*/cache/
assemblies/*/data/
assemblies/*/pdfs/

# Apex docs/ are small and central, but generated manifests churn with every
# run. They go to s3://radoskop-public/_main/ via deploy_main_s3.py; no need
# to track every regeneration in git.
docs/cities.json
docs/controversial-votes.json
docs/votes-index.json
docs/councilors-index.json
docs/interpelacje-index.json
docs/compare-index.json
docs/sitemap.xml
docs/sitemap-main.xml
